{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-5][0-9])$"
    },
    "optionalDate": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date" },
        { "$ref": "#/$defs/timestamp" }
      ]
    },
    "optionalAmount": { "type": ["number", "null"], "minimum": 0 },
    "optionalLabels": { "type": ["array", "null"], "items": { "type": "string" } },
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "latest_research_at",
    "scope",
    "last_research_run",
    "offers"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "latest_research_at": { "$ref": "#/$defs/timestamp" },
    "scope": { "type": "string", "minLength": 1 },
    "last_research_run": {
      "type": "object",
      "required": ["started_at", "completed_at", "reviewed_ids", "new_ids", "attempted_failed_ids", "unreviewed_existing_count"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "reviewed_ids": { "$ref": "#/$defs/ids" },
        "new_ids": { "$ref": "#/$defs/ids" },
        "attempted_failed_ids": { "$ref": "#/$defs/ids" },
        "unreviewed_existing_count": { "type": "integer", "minimum": 0 }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "verification",
          "review_cadence",
          "priority_tier",
          "priority_score",
          "categories",
          "sources",
          "verified_at",
          "taiwan",
          "quota_classification",
          "setup_cost_usd",
          "recurring_cost_usd",
          "benefit_cost_ratio",
          "eligibility",
          "unknowns",
          "record_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": { "type": "string", "minLength": 1 },
          "verified_at": { "$ref": "#/$defs/optionalDate" },
          "next_review_at": { "$ref": "#/$defs/optionalDate" },
          "deadline_at": { "$ref": "#/$defs/optionalDate" },
          "expires_at": { "$ref": "#/$defs/optionalDate" },
          "expiry": {
            "type": ["object", "string", "null"],
            "properties": {
              "date": {
                "anyOf": [
                  { "$ref": "#/$defs/optionalDate" },
                  { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }
                ]
              }
            }
          },
          "views": { "$ref": "#/$defs/optionalLabels" },
          "regions": { "$ref": "#/$defs/optionalLabels" },
          "effort_minutes_max": { "$ref": "#/$defs/optionalAmount" },
          "usable_benefit_usd": { "$ref": "#/$defs/optionalAmount" },
          "savings_usd": { "$ref": "#/$defs/optionalAmount" },
          "priority_tier": { "enum": ["S", "A", "B", "C", "D", null] },
          "priority_score": { "type": ["number", "null"] },
          "review_cadence": { "type": "string", "minLength": 1 },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "taiwan": {
            "enum": [
              "Yes",
              "No",
              "Unknown"
            ]
          },
          "verification": {
            "enum": [
              "Official",
              "Community reported",
              "Unverified"
            ]
          },
          "quota_classification": {
            "enum": [
              "OFFICIALLY UNLIMITED",
              "NO FIXED CAP PUBLISHED",
              "HIGH BUT LIMITED",
              "TEMPORARILY UNLIMITED",
              "UNKNOWN"
            ]
          },
          "setup_cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "recurring_cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "benefit_cost_ratio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "FREE",
                "LOW-COST",
                "VALUE-DEAL",
                "EASY-EFFORT",
                "QUALIFICATION",
                "REGION-LOCKED",
                "HIGH-QUOTA",
                "UNLIMITED-CLAIM",
                "BETA-ACCESS"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "scope",
                "evidence"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "record_type": {
            "enum": [
              "opportunity",
              "policy",
              "watchlist"
            ]
          },
          "legal_status": {
            "type": "string",
            "enum": [
              "not_verified",
              "no_restriction_found",
              "restriction_found"
            ]
          },
          "duplicate_of": {
            "description": "duplicate_merged 專用：指向同一方案的較早紀錄 ID；有值時 status 必須為 duplicate_merged。",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9-]+$"
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "eligibility": {
            "type": "object",
            "required": [
              "service_availability",
              "account_eligibility",
              "billing_country",
              "identity_residency",
              "terms_restrictions",
              "taiwan_note"
            ],
            "properties": {
              "service_availability": { "type": "string", "minLength": 1 },
              "account_eligibility": { "type": "string", "minLength": 1 },
              "billing_country": { "type": "string", "minLength": 1 },
              "identity_residency": { "type": "string", "minLength": 1 },
              "terms_restrictions": { "type": "string", "minLength": 1 },
              "taiwan_note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
